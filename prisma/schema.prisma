generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTENTIKASI & USER
// ============================================================

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  password    String
  role        String // "ADMIN" | "DOKTER" | "KASIR"
  namaLengkap String
  noTelepon   String?
  fotoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dokter Dokter?

  @@index([role])
}

// ============================================================
// POLI / DEPARTEMEN CLINIC
// ============================================================

model Poli {
  id        String   @id @default(uuid())
  namaPoli  String   @unique
  keterangan String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dokter Dokter[]
  jadwal Jadwal[]
}

// ============================================================
// PROFILE DOKTER
// ============================================================

model Dokter {
  id          String   @id @default(uuid())
  userId      String   @unique
  poliId      String
  namaLengkap String
  noTelepon   String?
  fotoUrl     String?
  sip         String?
  str         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  poli       Poli         @relation(fields: [poliId], references: [id])
  jadwal     Jadwal[]
  rekamMedis RekamMedis[]

  @@index([poliId])
}

// ============================================================
// PASIEN
// ============================================================

model Pasien {
  id           String   @id // Format: P0001, P0002, ...
  noRm         String   @unique // Format: R0001, R0002, ...
  nama         String
  jenisKelamin String // "LAKI_LAKI" | "PEREMPUAN"
  tanggalLahir String // format YYYY-MM-DD
  noTelepon    String?
  alamat       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jadwal     Jadwal[]
  rekamMedis RekamMedis[]
  pembayaran Pembayaran[]

  @@index([nama])
  @@index([noTelepon])
}

// ============================================================
// JADWAL / ANTRIAN
// ============================================================

model Jadwal {
  id           String   @id @default(uuid())
  pasienId     String
  dokterId     String
  poliId       String?
  tanggal      DateTime
  jam          String // e.g. "09:00"
  nomorAntrian Int
  keluhan      String?
  status       String   @default("MENUNGGU") // MENUNGGU | DIPERIKSA | SELESAI | BATAL
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pasien     Pasien       @relation(fields: [pasienId], references: [id], onDelete: Cascade)
  dokter     Dokter       @relation(fields: [dokterId], references: [id], onDelete: Cascade)
  poli       Poli?        @relation(fields: [poliId], references: [id])
  rekamMedis RekamMedis[]

  @@index([pasienId])
  @@index([dokterId])
  @@index([tanggal])
  @@index([status])
}

// ============================================================
// REKAM MEDIS
// ============================================================

model RekamMedis {
  id         String   @id @default(uuid())
  pasienId   String
  dokterId   String
  namaDokter String? // Snapshot nama dokter saat rekam medis dibuat
  jadwalId   String? // FK ke Jadwal (opsional)
  tanggal    DateTime @default(now())
  keluhan    String

  // === Anamnesis ===
  anamnesisKeluhanUtama    String?
  anamnesisRps             String?
  anamnesisRpd             String?
  anamnesisRiwayatObat     String?
  anamnesisRiwayatKeluarga String?
  anamnesisKebiasaan       String?

  // === Pemeriksaan / TTV ===
  tdSistolik       Int?
  tdDiastolik      Int?
  nadi             Int?
  rr               Int?
  suhu             Float?
  spo2             Int?
  bb               Float?
  tb               Float?
  bmi              Float?
  pemeriksaanFisik String?

  // === Edukasi & Catatan ===
  edukasiPasien   String?
  catatanTambahan String?
  rujukanCatatan  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pasien Pasien  @relation(fields: [pasienId], references: [id], onDelete: Cascade)
  dokter Dokter  @relation(fields: [dokterId], references: [id], onDelete: Cascade)
  jadwal Jadwal? @relation(fields: [jadwalId], references: [id])

  diagnosis          Diagnosis[]
  resep              Resep[]
  rujukan            Rujukan?             @relation(name: "RMToRujukan")
  pembayaran         Pembayaran[]
  rekamMedisTindakan RekamMedisTindakan[]

  @@index([pasienId])
  @@index([dokterId])
  @@index([tanggal])
}

// ============================================================
// PENYAKIT & DIAGNOSIS
// ============================================================

model Penyakit {
  id           String   @id @default(uuid())
  kodeIcd10    String   @unique
  namaPenyakit String
  deskripsi    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  diagnosis Diagnosis[]
}

model Diagnosis {
  id           String   @id @default(uuid())
  rekamMedisId String
  penyakitId   String
  catatan      String?
  createdAt    DateTime @default(now())

  rekamMedis RekamMedis @relation(fields: [rekamMedisId], references: [id], onDelete: Cascade)
  penyakit   Penyakit   @relation(fields: [penyakitId], references: [id])

  @@index([rekamMedisId])
  @@index([penyakitId])
}

// ============================================================
// OBAT & RESEP
// ============================================================

model Obat {
  id        String   @id @default(uuid())
  kodeObat  String   @unique
  namaObat  String
  satuan    String // e.g. "tablet" | "botol" | "capsul"
  hargaJual Float
  stok      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resep Resep[]
}

model Resep {
  id            String   @id @default(uuid())
  rekamMedisId  String
  obatId        String
  dosis         String
  aturan        String
  jumlah        Int
  hargaSnapshot Float
  createdAt     DateTime @default(now())

  rekamMedis RekamMedis @relation(fields: [rekamMedisId], references: [id], onDelete: Cascade)
  obat       Obat       @relation(fields: [obatId], references: [id])

  @@index([rekamMedisId])
  @@index([obatId])
}

// ============================================================
// TINDAKAN / PROSEDUR MEDIS
// ============================================================

model Tindakan {
  id           String   @id @default(uuid())
  kodeTindakan String   @unique
  namaTindakan String
  harga        Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rekamMedisTindakan RekamMedisTindakan[]
}

model RekamMedisTindakan {
  id            String   @id @default(uuid())
  rekamMedisId  String
  tindakanId    String
  hargaSnapshot Float
  kuantitas     Int      @default(1)
  keterangan    String?
  createdAt     DateTime @default(now())

  rekamMedis RekamMedis @relation(fields: [rekamMedisId], references: [id], onDelete: Cascade)
  tindakan   Tindakan   @relation(fields: [tindakanId], references: [id], onDelete: Cascade)

  @@index([rekamMedisId])
  @@index([tindakanId])
}

// ============================================================
// RUJUKAN
// ============================================================

model Rujukan {
  id             String   @id @default(uuid())
  rekamMedisId   String   @unique
  nomorSurat     String?  @unique
  tanggalRujukan DateTime @default(now())
  tujuan         String
  poliTujuan     String?
  diagnosa       String?
  keterangan     String?
  status         String   @default("DRAFT") // DRAFT | FINAL
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rekamMedis RekamMedis @relation(name: "RMToRujukan", fields: [rekamMedisId], references: [id], onDelete: Cascade)

  @@index([rekamMedisId])
}

// ============================================================
// PEMBAYARAN
// ============================================================

model Pembayaran {
  id           String   @id @default(uuid())
  pasienId     String
  rekamMedisId String?
  tanggal      DateTime @default(now())
  totalJumlah  Float
  metode       String // "TUNAI" | "TRANSFER" | "BPJS"
  status       String   @default("BELUM_BAYAR") // "BELUM_BAYAR" | "LUNAS"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pasien           Pasien             @relation(fields: [pasienId], references: [id], onDelete: Cascade)
  rekamMedis       RekamMedis?        @relation(fields: [rekamMedisId], references: [id])
  detailPembayaran DetailPembayaran[]

  @@index([pasienId])
  @@index([status])
}

model DetailPembayaran {
  id           String   @id @default(uuid())
  pembayaranId String
  tipeItem     String // "KONSULTASI" | "OBAT" | "TINDAKAN" | "LAINNYA"
  namaItem     String
  hargaSatuan  Float
  kuantitas    Int
  subtotal     Float
  createdAt    DateTime @default(now())

  pembayaran Pembayaran @relation(fields: [pembayaranId], references: [id], onDelete: Cascade)

  @@index([pembayaranId])
}